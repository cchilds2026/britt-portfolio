---
export interface CarouselImage {
  src: string;
  label?: string;
  alt: string;
  caption?: string;
}

interface Props {
  images: CarouselImage[];
  id?: string;
  mode?: "full" | "lightboxOnly" | "splitPreview";
}

const {
  images = [],
  id = `carousel-${Math.random().toString(36).slice(2, 9)}`,
  mode = "full"
} = Astro.props as Props;

const hasImages = images.length > 0;
const firstImage = images[0];
const firstMeta = [firstImage?.label, firstImage?.caption].filter(Boolean).join(" — ");
---

{hasImages && (
  <div class="image-carousel" data-carousel={id} data-mode={mode}>
    {mode === "full" ? (
      <>
        <div class="carousel-stage frame">
          <button class="carousel-arrow carousel-arrow--prev" type="button" aria-label="Previous image">
            ‹
          </button>

          <button
            class="carousel-image-button"
            type="button"
            aria-label={firstImage.label ? `Open gallery: ${firstImage.label}` : "Open gallery"}
          >
            <img
              class="carousel-main-image"
              src={firstImage.src}
              alt={firstImage.alt}
              data-carousel-main-image
            />
          </button>

          <button class="carousel-arrow carousel-arrow--next" type="button" aria-label="Next image">
            ›
          </button>
        </div>

        <div class="carousel-meta">
          <div class="carousel-count" data-carousel-count>1 / {images.length}</div>
          <div class="carousel-caption" data-carousel-caption>
            {firstMeta}
          </div>
        </div>

        {images.length > 1 && (
          <div class="carousel-thumbs" role="tablist" aria-label="Gallery thumbnails">
            {images.map((image, index) => (
              <button
                class={`carousel-thumb ${index === 0 ? "is-active" : ""}`}
                type="button"
                data-carousel-thumb
                data-index={index}
                aria-label={image.label ? `View ${image.label}` : `View image ${index + 1}`}
                aria-selected={index === 0 ? "true" : "false"}
              >
                <img src={image.src} alt={image.alt} />
              </button>
            ))}
          </div>
        )}
      </>
    ) : mode === "splitPreview" ? (
      <>
        <div class="carousel-split-main">
          <div class="carousel-preview frame">
            <button
              class="carousel-image-button carousel-image-button--preview"
              type="button"
              aria-label={firstImage.label ? `Open gallery: ${firstImage.label}` : "Open gallery"}
            >
              <img
                class="carousel-main-image carousel-main-image--preview"
                src={firstImage.src}
                alt={firstImage.alt}
                data-carousel-main-image
              />
            </button>
          </div>
        </div>

        {images.length > 1 && (
          <div
            class="carousel-thumbs carousel-thumbs--split"
            role="tablist"
            aria-label="Gallery thumbnails"
          >
            {images.map((image, index) => (
              <button
                class={`carousel-thumb ${index === 0 ? "is-active" : ""}`}
                type="button"
                data-carousel-thumb
                data-index={index}
                aria-label={image.label ? `View ${image.label}` : `View image ${index + 1}`}
                aria-selected={index === 0 ? "true" : "false"}
              >
                <img src={image.src} alt={image.alt} />
              </button>
            ))}
          </div>
        )}
      </>
    ) : (
      <div class="carousel-preview frame">
        <button
          class="carousel-image-button carousel-image-button--preview"
          type="button"
          aria-label={firstImage.label ? `Open gallery: ${firstImage.label}` : "Open gallery"}
        >
          <img
            class="carousel-main-image carousel-main-image--preview"
            src={firstImage.src}
            alt={firstImage.alt}
            data-carousel-main-image
          />
        </button>
      </div>
    )}

    <div class="carousel-lightbox" data-carousel-lightbox hidden>
      <button class="carousel-lightbox-close" type="button" aria-label="Close gallery">
        ×
      </button>

      <div class="carousel-lightbox-shell">
        <button class="carousel-lightbox-arrow carousel-lightbox-arrow--prev" type="button" aria-label="Previous image">
          ‹
        </button>

        <div class="carousel-lightbox-content">
          <div class="carousel-lightbox-image-wrap">
            <img
              class="carousel-lightbox-image"
              src={firstImage.src}
              alt={firstImage.alt}
              data-carousel-lightbox-image
            />
          </div>
          <div class="carousel-lightbox-caption" data-carousel-lightbox-caption>
            {firstMeta}
          </div>
        </div>

        <button class="carousel-lightbox-arrow carousel-lightbox-arrow--next" type="button" aria-label="Next image">
          ›
        </button>
      </div>
    </div>

    <script
      type="application/json"
      data-carousel-images
      set:html={JSON.stringify(images)}
    />
  </div>
)}

<script>
  // @ts-nocheck

  const setupCarousels = () => {
    const carousels = document.querySelectorAll("[data-carousel]");

    carousels.forEach((carouselEl) => {
      if (!(carouselEl instanceof HTMLElement)) return;
      const carousel = carouselEl;

      if (carousel.dataset.initialized === "true") return;
      carousel.dataset.initialized = "true";

      const imagesScript = carousel.querySelector("[data-carousel-images]");
      if (!(imagesScript instanceof HTMLScriptElement)) return;

      let images = [];
      try {
        images = JSON.parse(imagesScript.textContent || "[]");
      } catch {
        images = [];
      }

      if (!Array.isArray(images) || images.length === 0) return;

      let currentIndex = 0;

      const mainImageEl = carousel.querySelector("[data-carousel-main-image]");
      const countEl = carousel.querySelector("[data-carousel-count]");
      const captionEl = carousel.querySelector("[data-carousel-caption]");
      const thumbEls = carousel.querySelectorAll("[data-carousel-thumb]");
      const prevButtonEl = carousel.querySelector(".carousel-arrow--prev");
      const nextButtonEl = carousel.querySelector(".carousel-arrow--next");
      const openButtonEl = carousel.querySelector(".carousel-image-button");

      const lightboxEl = carousel.querySelector("[data-carousel-lightbox]");
      const lightboxImageEl = carousel.querySelector("[data-carousel-lightbox-image]");
      const lightboxCaptionEl = carousel.querySelector("[data-carousel-lightbox-caption]");
      const lightboxCloseEl = carousel.querySelector(".carousel-lightbox-close");
      const lightboxPrevEl = carousel.querySelector(".carousel-lightbox-arrow--prev");
      const lightboxNextEl = carousel.querySelector(".carousel-lightbox-arrow--next");

      const mainImage = mainImageEl instanceof HTMLImageElement ? mainImageEl : null;
      const count = countEl instanceof HTMLElement ? countEl : null;
      const caption = captionEl instanceof HTMLElement ? captionEl : null;
      const thumbs = Array.from(thumbEls).filter((el) => el instanceof HTMLButtonElement);
      const prevButton = prevButtonEl instanceof HTMLButtonElement ? prevButtonEl : null;
      const nextButton = nextButtonEl instanceof HTMLButtonElement ? nextButtonEl : null;
      const openButton = openButtonEl instanceof HTMLButtonElement ? openButtonEl : null;

      const lightbox = lightboxEl instanceof HTMLElement ? lightboxEl : null;
      const lightboxImage = lightboxImageEl instanceof HTMLImageElement ? lightboxImageEl : null;
      const lightboxCaption = lightboxCaptionEl instanceof HTMLElement ? lightboxCaptionEl : null;
      const lightboxClose = lightboxCloseEl instanceof HTMLButtonElement ? lightboxCloseEl : null;
      const lightboxPrev = lightboxPrevEl instanceof HTMLButtonElement ? lightboxPrevEl : null;
      const lightboxNext = lightboxNextEl instanceof HTMLButtonElement ? lightboxNextEl : null;

      function getMetaText(image) {
        return [image?.label, image?.caption].filter(Boolean).join(" — ");
      }

      function setImage(imgEl, src, alt) {
        if (!(imgEl instanceof HTMLImageElement)) return;
        imgEl.src = src;
        imgEl.alt = alt;
      }

      function update() {
        const current = images[currentIndex];
        if (!current) return;

        setImage(mainImage, current.src, current.alt);
        setImage(lightboxImage, current.src, current.alt);

        if (openButton) {
          openButton.setAttribute(
            "aria-label",
            current.label ? `Open gallery: ${current.label}` : "Open gallery"
          );
        }

        if (count) {
          count.textContent = `${currentIndex + 1} / ${images.length}`;
        }

        if (caption) {
          caption.textContent = getMetaText(current);
        }

        if (lightboxCaption) {
          lightboxCaption.textContent = getMetaText(current);
        }

        thumbs.forEach((thumb, index) => {
          const active = index === currentIndex;
          const image = images[index];

          thumb.classList.toggle("is-active", active);
          thumb.setAttribute("aria-selected", active ? "true" : "false");
          thumb.setAttribute(
            "aria-label",
            image?.label ? `View ${image.label}` : `View image ${index + 1}`
          );
        });
      }

      function goTo(index) {
        currentIndex = (index + images.length) % images.length;
        update();
      }

      function openLightbox() {
        if (!lightbox) return;
        update();
        lightbox.hidden = false;
        lightbox.classList.add("is-open");
        document.body.style.overflow = "hidden";
      }

      function closeLightbox() {
        if (!lightbox) return;
        lightbox.classList.remove("is-open");
        lightbox.hidden = true;
        document.body.style.overflow = "";
      }

      prevButton?.addEventListener("click", () => goTo(currentIndex - 1));
      nextButton?.addEventListener("click", () => goTo(currentIndex + 1));
      lightboxPrev?.addEventListener("click", () => goTo(currentIndex - 1));
      lightboxNext?.addEventListener("click", () => goTo(currentIndex + 1));
      openButton?.addEventListener("click", openLightbox);
      lightboxClose?.addEventListener("click", closeLightbox);

      thumbs.forEach((thumb, index) => {
        thumb.addEventListener("click", () => goTo(index));
      });

      lightbox?.addEventListener("click", (event) => {
        if (event.target === lightbox) closeLightbox();
      });

      document.addEventListener("keydown", (event) => {
        if (!lightbox || lightbox.hidden) return;

        if (event.key === "Escape") closeLightbox();
        if (event.key === "ArrowLeft") goTo(currentIndex - 1);
        if (event.key === "ArrowRight") goTo(currentIndex + 1);
      });

      update();
    });
  };

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", setupCarousels);
  } else {
    setupCarousels();
  }
</script>