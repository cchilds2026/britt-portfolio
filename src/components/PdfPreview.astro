---
const { id, documents = [], showThumbs = true } = Astro.props;
const safeId = id ?? `pdf-preview-${Math.random().toString(36).slice(2, 9)}`;
const serializedDocuments = JSON.stringify(documents);
---

<div
  class="pdf-preview"
  data-pdf-preview
  data-preview-id={safeId}
  id={safeId}
>
  <div class="pdf-preview__desktop" data-pdf-desktop-view>
    <button
      type="button"
      class="pdf-preview__trigger"
      data-pdf-trigger
      aria-haspopup="dialog"
      aria-controls={`${safeId}-lightbox`}
    >
      <div class="pdf-preview__trigger-inner">
        <canvas class="pdf-preview__trigger-canvas" data-pdf-main-canvas></canvas>
        <div class="pdf-preview__overlay">
          <span class="pdf-preview__overlay-label">Open document preview</span>
        </div>
      </div>
    </button>

    <p class="pdf-preview__inline-caption meta" data-pdf-inline-caption></p>

    {showThumbs && (
      <div
        class="pdf-preview__thumbs"
        data-pdf-thumbs
        role="tablist"
        aria-label="Document previews"
      ></div>
    )}
  </div>

  <div class="pdf-preview__mobile" data-pdf-mobile-view hidden>
    <div class="pdf-preview__mobile-card">
      <div class="pdf-preview__mobile-label" data-pdf-mobile-label></div>
      <p class="pdf-preview__mobile-caption meta" data-pdf-mobile-caption></p>
      <a
        class="pdf-preview__mobile-link"
        data-pdf-mobile-link
        href="#"
        target="_blank"
        rel="noopener noreferrer"
      >
        Open PDF
      </a>
    </div>
  </div>

  <div
    class="pdf-lightbox"
    id={`${safeId}-lightbox`}
    data-pdf-lightbox
    hidden
    aria-hidden="true"
  >
    <button
      type="button"
      class="pdf-lightbox__backdrop"
      data-pdf-close
      aria-label="Close document preview"
    ></button>

    <div class="pdf-lightbox__dialog" role="dialog" aria-modal="true" aria-label="PDF preview">
      <button
        type="button"
        class="pdf-lightbox__close"
        data-pdf-close
        aria-label="Close"
      >
        ×
      </button>

      <div class="pdf-lightbox__topbar">
        <div class="pdf-lightbox__doc-tabs" data-pdf-doc-tabs></div>
      </div>

      <div class="pdf-lightbox__viewer">
        <button
          type="button"
          class="pdf-lightbox__nav"
          data-pdf-prev
          aria-label="Previous page"
        >
          ‹
        </button>

        <div class="pdf-lightbox__canvas-wrap">
          <canvas class="pdf-lightbox__canvas" data-pdf-lightbox-canvas></canvas>
        </div>

        <button
          type="button"
          class="pdf-lightbox__nav"
          data-pdf-next
          aria-label="Next page"
        >
          ›
        </button>
      </div>

      <div class="pdf-lightbox__footer">
        <div class="pdf-lightbox__status" data-pdf-status></div>
        <p class="pdf-lightbox__caption" data-pdf-caption></p>
      </div>
    </div>
  </div>

  <script type="application/json" data-pdf-documents set:html={serializedDocuments}></script>
</div>

<script type="module">
  const MOBILE_MEDIA = "(max-width: 768px)";
  let pdfjsPromise = null;

  function isMobileView() {
    return window.matchMedia(MOBILE_MEDIA).matches;
  }

  async function getPdfJs() {
    if (!pdfjsPromise) {
      pdfjsPromise = import("https://cdn.jsdelivr.net/npm/pdfjs-dist@4.4.168/build/pdf.min.mjs")
        .then((pdfjsLib) => {
          pdfjsLib.GlobalWorkerOptions.workerSrc =
            "https://cdn.jsdelivr.net/npm/pdfjs-dist@4.4.168/build/pdf.worker.min.mjs";
          return pdfjsLib;
        });
    }

    return pdfjsPromise;
  }

  async function loadPdf(url) {
    const pdfjsLib = await getPdfJs();
    const loadingTask = pdfjsLib.getDocument(url);
    return await loadingTask.promise;
  }

  async function renderPageToCanvas(pdf, pageNumber, canvas, maxWidth, maxHeight) {
    const page = await pdf.getPage(pageNumber);
    const baseViewport = page.getViewport({ scale: 1 });

    let scale = maxWidth / baseViewport.width;
    if (maxHeight) {
      scale = Math.min(scale, maxHeight / baseViewport.height);
    }

    const viewport = page.getViewport({ scale });
    const context = canvas.getContext("2d");
    const ratio = window.devicePixelRatio || 1;

    canvas.width = Math.floor(viewport.width * ratio);
    canvas.height = Math.floor(viewport.height * ratio);
    canvas.style.width = `${viewport.width}px`;
    canvas.style.height = `${viewport.height}px`;

    context.setTransform(ratio, 0, 0, ratio, 0, 0);
    context.clearRect(0, 0, canvas.width, canvas.height);

    await page.render({
      canvasContext: context,
      viewport
    }).promise;
  }

  function ensurePdfState(root, documents) {
    if (root.__pdfState) return root.__pdfState;

    root.__pdfState = {
      documents,
      activeDocIndex: 0,
      activePage: 1,
      activePdf: null,
      isLightboxOpen: false,
      previewRoots: new Set()
    };

    return root.__pdfState;
  }

  function broadcastDocumentChange(previewId, index) {
    document.dispatchEvent(
      new CustomEvent("pdf-preview:set-document", {
        detail: { previewId, index }
      })
    );
  }

  function initPdfPreview(root) {
    if (!root || root.dataset.pdfInitialized === "true") return;
    root.dataset.pdfInitialized = "true";

    const dataEl = root.querySelector("[data-pdf-documents]");
    if (!dataEl) return;

    const documents = JSON.parse(dataEl.textContent || "[]");
    if (!documents.length) return;

    const previewId = root.dataset.previewId;

    const desktopView = root.querySelector("[data-pdf-desktop-view]");
    const mobileView = root.querySelector("[data-pdf-mobile-view]");
    const mobileLabel = root.querySelector("[data-pdf-mobile-label]");
    const mobileCaption = root.querySelector("[data-pdf-mobile-caption]");
    const mobileLink = root.querySelector("[data-pdf-mobile-link]");

    const trigger = root.querySelector("[data-pdf-trigger]");
    const mainCanvas = root.querySelector("[data-pdf-main-canvas]");
    const inlineCaption = root.querySelector("[data-pdf-inline-caption]");
    const thumbsWrap = root.querySelector("[data-pdf-thumbs]");

    const lightbox = root.querySelector("[data-pdf-lightbox]");
    const lightboxCanvas = root.querySelector("[data-pdf-lightbox-canvas]");
    const docTabs = root.querySelector("[data-pdf-doc-tabs]");
    const captionEl = root.querySelector("[data-pdf-caption]");
    const statusEl = root.querySelector("[data-pdf-status]");
    const prevBtn = root.querySelector("[data-pdf-prev]");
    const nextBtn = root.querySelector("[data-pdf-next]");
    const closeButtons = root.querySelectorAll("[data-pdf-close]");

    const state = ensurePdfState(root, documents);
    state.previewRoots.add(root);

    function syncLayoutMode() {
      const mobile = isMobileView();

      if (desktopView) desktopView.hidden = mobile;
      if (mobileView) mobileView.hidden = !mobile;

      if (mobile && state.isLightboxOpen) {
        closeLightbox();
      }
    }

    function updateThumbStates() {
      const thumbs = root.querySelectorAll(".pdf-preview__thumb");
      thumbs.forEach((thumb, index) => {
        thumb.classList.toggle("is-active", index === state.activeDocIndex);
        thumb.setAttribute("aria-selected", index === state.activeDocIndex ? "true" : "false");
      });
    }

    function updateDocTabStates() {
      const tabs = docTabs.querySelectorAll(".pdf-lightbox__doc-tab");
      tabs.forEach((tab, index) => {
        tab.classList.toggle("is-active", index === state.activeDocIndex);
      });
    }

    function renderMobilePreview() {
      const doc = documents[state.activeDocIndex];
      if (!doc) return;

      if (mobileLabel) mobileLabel.textContent = doc.label || "Open document";
      if (mobileCaption) mobileCaption.textContent = doc.caption || "";
      if (mobileLink) mobileLink.href = doc.src;
    }

    async function renderMainPreview() {
      const doc = documents[state.activeDocIndex];
      inlineCaption.textContent = doc?.caption || "";

      if (isMobileView()) {
        renderMobilePreview();
        return;
      }

      try {
        const pdf = await loadPdf(doc.src);
        await renderPageToCanvas(pdf, 1, mainCanvas, 520, 700);
      } catch (error) {
        console.error("Main preview render failed:", error);
      }

      updateThumbStates();
    }

    async function renderLightboxPage() {
      if (!state.activePdf || isMobileView()) return;

      const wrap = lightboxCanvas.closest(".pdf-lightbox__canvas-wrap");
      const availableWidth = Math.max(300, wrap.clientWidth - 32);
      const availableHeight = Math.max(300, wrap.clientHeight - 32);

      await renderPageToCanvas(
        state.activePdf,
        state.activePage,
        lightboxCanvas,
        availableWidth,
        availableHeight
      );

      statusEl.textContent = `Page ${state.activePage} of ${state.activePdf.numPages}`;
      captionEl.textContent = documents[state.activeDocIndex]?.caption || "";

      prevBtn.disabled = state.activePage <= 1;
      nextBtn.disabled = state.activePage >= state.activePdf.numPages;
    }

    async function setActiveDocument(index, preserveLightbox = false) {
      state.activeDocIndex = index;
      state.activePage = 1;
      state.activePdf = null;

      renderMobilePreview();

      if (!isMobileView()) {
        state.activePdf = await loadPdf(documents[state.activeDocIndex].src);
      }

      await renderMainPreview();
      updateDocTabStates();

      if (!isMobileView() && (preserveLightbox || state.isLightboxOpen)) {
        await renderLightboxPage();
      }
    }

    function renderDocTabs() {
      docTabs.innerHTML = "";

      documents.forEach((doc, index) => {
        const button = document.createElement("button");
        button.type = "button";
        button.className = "pdf-lightbox__doc-tab";
        if (index === state.activeDocIndex) button.classList.add("is-active");
        button.textContent = doc.label;

        button.addEventListener("click", async () => {
          broadcastDocumentChange(previewId, index);
          await setActiveDocument(index, true);
        });

        docTabs.appendChild(button);
      });
    }

    async function renderThumb(doc, index) {
      if (!thumbsWrap || isMobileView()) return;

      const thumbBtn = document.createElement("button");
      thumbBtn.type = "button";
      thumbBtn.className = "pdf-preview__thumb";
      thumbBtn.dataset.docIndex = String(index);
      thumbBtn.setAttribute("role", "tab");
      thumbBtn.setAttribute("aria-selected", index === state.activeDocIndex ? "true" : "false");

      const thumbCanvas = document.createElement("canvas");
      thumbCanvas.className = "pdf-preview__thumb-canvas";

      const thumbLabel = document.createElement("span");
      thumbLabel.className = "pdf-preview__thumb-label";
      thumbLabel.textContent = doc.label;

      thumbBtn.appendChild(thumbCanvas);
      thumbBtn.appendChild(thumbLabel);

      thumbBtn.addEventListener("click", async () => {
        broadcastDocumentChange(previewId, index);
        await setActiveDocument(index);
      });

      thumbsWrap.appendChild(thumbBtn);

      try {
        const pdf = await loadPdf(doc.src);
        await renderPageToCanvas(pdf, 1, thumbCanvas, 140, 180);
      } catch (error) {
        console.error("Thumbnail render failed:", error);
      }
    }

    async function openLightbox() {
      if (isMobileView()) return;

      state.isLightboxOpen = true;
      lightbox.hidden = false;
      lightbox.classList.add("is-open");
      lightbox.setAttribute("aria-hidden", "false");

      if (!state.activePdf) {
        state.activePdf = await loadPdf(documents[state.activeDocIndex].src);
      }

      await renderLightboxPage();
    }

    function closeLightbox() {
      state.isLightboxOpen = false;
      lightbox.classList.remove("is-open");
      lightbox.setAttribute("aria-hidden", "true");
      lightbox.hidden = true;
    }

    trigger?.addEventListener("click", openLightbox);

    closeButtons.forEach((button) => {
      button.addEventListener("click", closeLightbox);
    });

    prevBtn?.addEventListener("click", async () => {
      if (!state.activePdf || state.activePage <= 1) return;
      state.activePage -= 1;
      await renderLightboxPage();
    });

    nextBtn?.addEventListener("click", async () => {
      if (!state.activePdf || state.activePage >= state.activePdf.numPages) return;
      state.activePage += 1;
      await renderLightboxPage();
    });

    document.addEventListener("pdf-preview:set-document", async (event) => {
      const { previewId: targetId, index } = event.detail || {};
      if (targetId !== previewId) return;
      if (index === state.activeDocIndex) return;
      await setActiveDocument(index, state.isLightboxOpen);
    });

    window.addEventListener("keydown", async (event) => {
      if (!state.isLightboxOpen) return;

      if (event.key === "Escape") {
        closeLightbox();
      }

      if (event.key === "ArrowLeft" && state.activePage > 1) {
        state.activePage -= 1;
        await renderLightboxPage();
      }

      if (event.key === "ArrowRight" && state.activePdf && state.activePage < state.activePdf.numPages) {
        state.activePage += 1;
        await renderLightboxPage();
      }
    });

    window.addEventListener("resize", async () => {
      syncLayoutMode();

      if (isMobileView()) return;

      if (state.isLightboxOpen) {
        await renderLightboxPage();
      } else {
        await renderMainPreview();
      }
    });

    syncLayoutMode();
    renderDocTabs();

    if (thumbsWrap && !isMobileView()) {
      thumbsWrap.innerHTML = "";
      documents.forEach((doc, index) => {
        renderThumb(doc, index);
      });
    }

    setActiveDocument(0);
  }

  function initAllPdfPreviews() {
    document.querySelectorAll("[data-pdf-preview]").forEach(initPdfPreview);
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initAllPdfPreviews, { once: true });
  } else {
    initAllPdfPreviews();
  }
</script>