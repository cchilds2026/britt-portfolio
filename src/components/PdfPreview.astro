---
interface DocumentItem {
  src: string;
  label: string;
  caption?: string;
}

interface Props {
  id: string;
  documents: DocumentItem[];
}

const { id, documents } = Astro.props;
const initialDoc = documents[0];
---

<div
  class="pdf-preview"
  data-pdf-preview={id}
  data-initial-doc={initialDoc?.src}
>
  <button
    type="button"
    class="pdf-preview__trigger frame"
    data-open-lightbox
    aria-label="Open PDF preview"
  >
    <div class="pdf-preview__trigger-inner">
      <canvas class="pdf-preview__trigger-canvas" aria-hidden="true"></canvas>

      <div class="pdf-preview__overlay">
        <span class="pdf-preview__overlay-label">View Pages</span>
      </div>
    </div>
  </button>

  <p class="pdf-preview__inline-caption meta">
    {initialDoc?.caption ?? ""}
  </p>

  <div class="pdf-lightbox" hidden data-lightbox>
    <button
      type="button"
      class="pdf-lightbox__backdrop"
      data-close-lightbox
      aria-label="Close PDF preview"
    ></button>

    <div class="pdf-lightbox__dialog" role="dialog" aria-modal="true" aria-label="PDF preview">
      <button
        type="button"
        class="pdf-lightbox__close"
        data-close-lightbox
        aria-label="Close PDF preview"
      >
        ×
      </button>

      <div class="pdf-lightbox__topbar">
        <div class="pdf-lightbox__doc-tabs" role="tablist" aria-label="Choose document">
          {documents.map((doc, index) => (
            <button
              type="button"
              class={`pdf-lightbox__doc-tab ${index === 0 ? "is-active" : ""}`}
              data-doc-tab
              data-src={doc.src}
              data-caption={doc.caption ?? ""}
              aria-selected={index === 0 ? "true" : "false"}
            >
              {doc.label}
            </button>
          ))}
        </div>
      </div>

      <div class="pdf-lightbox__viewer">
        <button type="button" class="pdf-lightbox__nav pdf-lightbox__nav--prev" data-prev-page>
          ‹
        </button>

        <div class="pdf-lightbox__canvas-wrap">
          <canvas class="pdf-lightbox__canvas" aria-label="PDF page preview"></canvas>
        </div>

        <button type="button" class="pdf-lightbox__nav pdf-lightbox__nav--next" data-next-page>
          ›
        </button>
      </div>

      <div class="pdf-lightbox__footer">
        <div class="pdf-lightbox__status" data-page-status>Page 1 of 1</div>
        <p class="pdf-lightbox__caption" data-caption>
          {initialDoc?.caption ?? ""}
        </p>
      </div>
    </div>
  </div>
</div>

<script>
  import * as pdfjsLib from "pdfjs-dist/build/pdf.mjs";
  import workerUrl from "pdfjs-dist/build/pdf.worker.mjs?url";

  pdfjsLib.GlobalWorkerOptions.workerSrc = workerUrl;

  function initPdfPreview(root) {
    const triggerCanvas = root.querySelector(".pdf-preview__trigger-canvas");
    const lightboxCanvas = root.querySelector(".pdf-lightbox__canvas");
    const openButton = root.querySelector("[data-open-lightbox]");
    const closeButtons = root.querySelectorAll("[data-close-lightbox]");
    const lightbox = root.querySelector("[data-lightbox]");
    const prevButton = root.querySelector("[data-prev-page]");
    const nextButton = root.querySelector("[data-next-page]");
    const pageStatus = root.querySelector("[data-page-status]");
    const captionEl = root.querySelector("[data-caption]");
    const inlineCaption = root.querySelector(".pdf-preview__inline-caption");
    const tabs = Array.from(root.querySelectorAll("[data-doc-tab]"));

    let pdfDoc = null;
    let currentPage = 1;
    let currentSrc = root.getAttribute("data-initial-doc") || "";
    let renderTask = null;

    async function loadDocument(src) {
      if (!src || !triggerCanvas || !lightboxCanvas) return;

      currentSrc = src;
      currentPage = 1;

      if (renderTask) {
        try {
          renderTask.cancel();
        } catch {}
      }

      const loadingTask = pdfjsLib.getDocument(src);
      pdfDoc = await loadingTask.promise;

      await renderTriggerPage();
      await renderLightboxPage();
      updateUi();
    }

    async function renderToCanvas(canvas, pageNumber, scale) {
      if (!pdfDoc || !canvas) return;

      const page = await pdfDoc.getPage(pageNumber);
      const viewport = page.getViewport({ scale });
      const context = canvas.getContext("2d");
      const ratio = window.devicePixelRatio || 1;

      canvas.width = Math.floor(viewport.width * ratio);
      canvas.height = Math.floor(viewport.height * ratio);
      canvas.style.width = `${viewport.width}px`;
      canvas.style.height = `${viewport.height}px`;

      context.setTransform(ratio, 0, 0, ratio, 0, 0);

      renderTask = page.render({
        canvasContext: context,
        viewport
      });

      await renderTask.promise;
    }

    async function renderTriggerPage() {
      await renderToCanvas(triggerCanvas, 1, 0.72);
    }

    async function renderLightboxPage() {
      await renderToCanvas(lightboxCanvas, currentPage, 0.9);
    }

    function updateUi() {
      if (!pdfDoc) return;

      if (pageStatus) {
        pageStatus.textContent = `Page ${currentPage} of ${pdfDoc.numPages}`;
      }

      if (prevButton) prevButton.disabled = currentPage <= 1;
      if (nextButton) nextButton.disabled = currentPage >= pdfDoc.numPages;

      tabs.forEach((tab) => {
        const isActive = tab.getAttribute("data-src") === currentSrc;
        tab.classList.toggle("is-active", isActive);
        tab.setAttribute("aria-selected", isActive ? "true" : "false");

        if (isActive) {
          const caption = tab.getAttribute("data-caption") || "";
          if (captionEl) captionEl.textContent = caption;
          if (inlineCaption) inlineCaption.textContent = caption;
        }
      });
    }

    function openLightbox() {
      if (!lightbox) return;
      lightbox.hidden = false;
      requestAnimationFrame(() => {
        lightbox.classList.add("is-open");
      });
      
    }

    function closeLightbox() {
      if (!lightbox) return;
      lightbox.classList.remove("is-open");
      window.setTimeout(() => {
        lightbox.hidden = true;
      }, 220);
    }

    openButton?.addEventListener("click", openLightbox);

    closeButtons.forEach((button) => {
      button.addEventListener("click", closeLightbox);
    });

    prevButton?.addEventListener("click", async () => {
      if (!pdfDoc || currentPage <= 1) return;
      currentPage -= 1;
      await renderLightboxPage();
      updateUi();
    });

    nextButton?.addEventListener("click", async () => {
      if (!pdfDoc || currentPage >= pdfDoc.numPages) return;
      currentPage += 1;
      await renderLightboxPage();
      updateUi();
    });

    tabs.forEach((tab) => {
      tab.addEventListener("click", async () => {
        const src = tab.getAttribute("data-src");
        await loadDocument(src);
      });
    });

    document.addEventListener("keydown", async (event) => {
      if (!lightbox || lightbox.hidden) return;

      if (event.key === "Escape") {
        closeLightbox();
      } else if (event.key === "ArrowLeft" && pdfDoc && currentPage > 1) {
        currentPage -= 1;
        await renderLightboxPage();
        updateUi();
      } else if (event.key === "ArrowRight" && pdfDoc && currentPage < pdfDoc.numPages) {
        currentPage += 1;
        await renderLightboxPage();
        updateUi();
      }
    });

    loadDocument(currentSrc);
  }

  document.querySelectorAll("[data-pdf-preview]").forEach((root) => {
    initPdfPreview(root);
  });
</script>