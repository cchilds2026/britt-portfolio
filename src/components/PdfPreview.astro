---
const { id, documents = [] } = Astro.props;
const safeId = id ?? `pdf-preview-${Math.random().toString(36).slice(2, 9)}`;
const serializedDocuments = JSON.stringify(documents);
---

<div
  class="pdf-preview"
  data-pdf-preview
  data-preview-id={safeId}
  id={safeId}
>
  <div class="pdf-preview__desktop" data-pdf-desktop hidden>
    <button
      type="button"
      class="pdf-preview__trigger"
      data-pdf-trigger
      aria-haspopup="dialog"
      aria-controls={`${safeId}-lightbox`}
    >
      <div class="pdf-preview__trigger-inner">
        <canvas class="pdf-preview__trigger-canvas" data-pdf-main-canvas></canvas>
        <div class="pdf-preview__overlay">
          <span class="pdf-preview__overlay-label">Open document preview</span>
        </div>
      </div>
    </button>

    <p class="pdf-preview__inline-caption meta" data-pdf-inline-caption></p>
  </div>

  <div class="pdf-preview__mobile" data-pdf-mobile hidden>
    <div class="pdf-preview__mobile-card">
      <div class="pdf-preview__mobile-label" data-pdf-mobile-label></div>
      <p class="pdf-preview__mobile-caption meta" data-pdf-mobile-caption></p>
      <div class="pdf-preview__mobile-actions">
        <a
          class="pdf-preview__mobile-link"
          data-pdf-mobile-open
          href="#"
          target="_blank"
          rel="noopener noreferrer"
        >
          Open PDF
        </a>
      </div>
    </div>
  </div>

  <div
    class="pdf-lightbox"
    id={`${safeId}-lightbox`}
    data-pdf-lightbox
    hidden
    aria-hidden="true"
  >
    <button
      type="button"
      class="pdf-lightbox__backdrop"
      data-pdf-close
      aria-label="Close document preview"
    ></button>

    <div class="pdf-lightbox__dialog" role="dialog" aria-modal="true" aria-label="PDF preview">
      <button
        type="button"
        class="pdf-lightbox__close"
        data-pdf-close
        aria-label="Close"
      >
        ×
      </button>

      <div class="pdf-lightbox__topbar">
        <div class="pdf-lightbox__doc-tabs" data-pdf-doc-tabs></div>
      </div>

      <div class="pdf-lightbox__viewer">
        <button
          type="button"
          class="pdf-lightbox__nav"
          data-pdf-prev
          aria-label="Previous page"
        >
          ‹
        </button>

        <div class="pdf-lightbox__canvas-wrap">
          <canvas class="pdf-lightbox__canvas" data-pdf-lightbox-canvas></canvas>
        </div>

        <button
          type="button"
          class="pdf-lightbox__nav"
          data-pdf-next
          aria-label="Next page"
        >
          ›
        </button>
      </div>

      <div class="pdf-lightbox__footer">
        <div class="pdf-lightbox__status" data-pdf-status></div>
        <p class="pdf-lightbox__caption" data-pdf-caption></p>
      </div>
    </div>
  </div>

  <script type="application/json" data-pdf-documents set:html={serializedDocuments}></script>
</div>

<script type="module">
  const MOBILE_BREAKPOINT = 768;
  let pdfjsLibPromise = null;

  function isMobile() {
    return window.innerWidth <= MOBILE_BREAKPOINT;
  }

  async function getPdfJs() {
    if (!pdfjsLibPromise) {
      pdfjsLibPromise = import("https://cdn.jsdelivr.net/npm/pdfjs-dist@4.4.168/build/pdf.min.mjs")
        .then((pdfjsLib) => {
          pdfjsLib.GlobalWorkerOptions.workerSrc =
            "https://cdn.jsdelivr.net/npm/pdfjs-dist@4.4.168/build/pdf.worker.min.mjs";
          return pdfjsLib;
        });
    }
    return pdfjsLibPromise;
  }

  async function loadPdf(url) {
    const pdfjsLib = await getPdfJs();
    return await pdfjsLib.getDocument(url).promise;
  }

  async function renderPageToCanvas(pdf, pageNumber, canvas, maxWidth, maxHeight) {
    const page = await pdf.getPage(pageNumber);
    const baseViewport = page.getViewport({ scale: 1 });

    let scale = maxWidth / baseViewport.width;
    if (maxHeight) {
      scale = Math.min(scale, maxHeight / baseViewport.height);
    }

    const viewport = page.getViewport({ scale });
    const context = canvas.getContext("2d");
    const ratio = window.devicePixelRatio || 1;

    canvas.width = Math.floor(viewport.width * ratio);
    canvas.height = Math.floor(viewport.height * ratio);
    canvas.style.width = `${viewport.width}px`;
    canvas.style.height = `${viewport.height}px`;

    context.setTransform(ratio, 0, 0, ratio, 0, 0);
    context.clearRect(0, 0, canvas.width, canvas.height);

    await page.render({
      canvasContext: context,
      viewport
    }).promise;
  }

  function initPdfPreview(root) {
    if (!root || root.dataset.pdfInitialized === "true") return;
    root.dataset.pdfInitialized = "true";

    const docsEl = root.querySelector("[data-pdf-documents]");
    const documents = JSON.parse(docsEl?.textContent || "[]");
    if (!documents.length) return;

    const previewId = root.dataset.previewId;
    let activeDocIndex = 0;
    let activePage = 1;
    let activePdf = null;
    let desktopReady = false;
    let lightboxOpen = false;

    const desktopWrap = root.querySelector("[data-pdf-desktop]");
    const mobileWrap = root.querySelector("[data-pdf-mobile]");
    const mobileLabel = root.querySelector("[data-pdf-mobile-label]");
    const mobileCaption = root.querySelector("[data-pdf-mobile-caption]");
    const mobileOpen = root.querySelector("[data-pdf-mobile-open]");

    const trigger = root.querySelector("[data-pdf-trigger]");
    const mainCanvas = root.querySelector("[data-pdf-main-canvas]");
    const inlineCaption = root.querySelector("[data-pdf-inline-caption]");
    const lightbox = root.querySelector("[data-pdf-lightbox]");
    const lightboxCanvas = root.querySelector("[data-pdf-lightbox-canvas]");
    const docTabs = root.querySelector("[data-pdf-doc-tabs]");
    const captionEl = root.querySelector("[data-pdf-caption]");
    const statusEl = root.querySelector("[data-pdf-status]");
    const prevBtn = root.querySelector("[data-pdf-prev]");
    const nextBtn = root.querySelector("[data-pdf-next]");
    const closeButtons = root.querySelectorAll("[data-pdf-close]");

    function currentDoc() {
      return documents[activeDocIndex];
    }

    function renderMobileState() {
      const doc = currentDoc();
      if (!doc) return;
      mobileLabel.textContent = doc.label || "";
      mobileCaption.textContent = doc.caption || "";
      mobileOpen.href = doc.src;
    }

    function renderDocTabs() {
      docTabs.innerHTML = "";
      documents.forEach((doc, index) => {
        const btn = document.createElement("button");
        btn.type = "button";
        btn.className = "pdf-lightbox__doc-tab";
        if (index === activeDocIndex) btn.classList.add("is-active");
        btn.textContent = doc.label;
        btn.addEventListener("click", async () => {
          setActiveDocument(index, true);
          broadcast(index);
        });
        docTabs.appendChild(btn);
      });
    }

    function updateDocTabs() {
      docTabs.querySelectorAll(".pdf-lightbox__doc-tab").forEach((tab, index) => {
        tab.classList.toggle("is-active", index === activeDocIndex);
      });
    }

    async function renderDesktopPreview() {
      const doc = currentDoc();
      if (!doc) return;
      inlineCaption.textContent = doc.caption || "";

      if (!activePdf) {
        activePdf = await loadPdf(doc.src);
      }

      await renderPageToCanvas(activePdf, 1, mainCanvas, 520, 700);
    }

    async function renderLightboxPage() {
      if (!activePdf) return;

      const wrap = lightboxCanvas.closest(".pdf-lightbox__canvas-wrap");
      const availableWidth = Math.max(300, wrap.clientWidth - 32);
      const availableHeight = Math.max(300, wrap.clientHeight - 32);

      await renderPageToCanvas(activePdf, activePage, lightboxCanvas, availableWidth, availableHeight);

      statusEl.textContent = `Page ${activePage} of ${activePdf.numPages}`;
      captionEl.textContent = currentDoc()?.caption || "";
      prevBtn.disabled = activePage <= 1;
      nextBtn.disabled = activePage >= activePdf.numPages;
    }

    async function ensureDesktopInit() {
      if (desktopReady || isMobile()) return;
      desktopReady = true;
      renderDocTabs();
      await setActiveDocument(activeDocIndex, false);
    }

    async function setActiveDocument(index, preserveLightbox = false) {
      activeDocIndex = index;
      activePage = 1;
      activePdf = null;

      renderMobileState();

      if (!isMobile()) {
        await ensureDesktopInit();
        activePdf = await loadPdf(currentDoc().src);
        await renderDesktopPreview();
        updateDocTabs();

        if (preserveLightbox || lightboxOpen) {
          await renderLightboxPage();
        }
      }
    }

    async function openLightbox() {
      if (isMobile()) return;
      lightbox.hidden = false;
      lightbox.classList.add("is-open");
      lightbox.setAttribute("aria-hidden", "false");
      lightboxOpen = true;
      renderLightboxPage();
    }

    function closeLightbox() {
      lightbox.hidden = true;
      lightbox.classList.remove("is-open");
      lightbox.setAttribute("aria-hidden", "true");
      lightboxOpen = false;
    }

    function applyMode() {
      const mobile = isMobile();
      mobileWrap.hidden = !mobile;
      desktopWrap.hidden = mobile;
      if (mobile) {
        closeLightbox();
        renderMobileState();
      } else {
        ensureDesktopInit();
      }
    }

    function broadcast(index) {
      document.dispatchEvent(
        new CustomEvent("pdf-preview:set-document", {
          detail: { previewId, index }
        })
      );
    }

    trigger?.addEventListener("click", () => {
      openLightbox();
    });

    prevBtn?.addEventListener("click", async () => {
      if (!activePdf || activePage <= 1) return;
      activePage -= 1;
      await renderLightboxPage();
    });

    nextBtn?.addEventListener("click", async () => {
      if (!activePdf || activePage >= activePdf.numPages) return;
      activePage += 1;
      await renderLightboxPage();
    });

    document.addEventListener("pdf-preview:set-document", async (event) => {
      const detail = event.detail || {};
      if (detail.previewId !== previewId) return;
      if (detail.index === activeDocIndex) return;
      await setActiveDocument(detail.index, lightboxOpen);
    });

    window.addEventListener("keydown", async (event) => {
      if (!lightboxOpen) return;
      if (event.key === "Escape") closeLightbox();
      if (event.key === "ArrowLeft" && activePage > 1) {
        activePage -= 1;
        await renderLightboxPage();
      }
      if (event.key === "ArrowRight" && activePdf && activePage < activePdf.numPages) {
        activePage += 1;
        await renderLightboxPage();
      }
    });

    let resizeTimer;
    window.addEventListener("resize", () => {
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(() => {
        applyMode();
      }, 150);
    });

    applyMode();
    renderMobileState();
  }

  function initAllPdfPreviews() {
    document.querySelectorAll("[data-pdf-preview]").forEach(initPdfPreview);
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initAllPdfPreviews, { once: true });
  } else {
    initAllPdfPreviews();
  }
</script>