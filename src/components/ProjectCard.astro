---
const { project } = Astro.props;
---

<a class="card reveal" href={project.href}>
  <div class="frame">
    <img
      src={project.image}
      alt={project.imageAlt ?? project.title}
      class={project.imageClass}
      data-label={project.imageLabel ?? undefined}
    />
  </div>
  <div class="card-body">
    <div class="meta">{project.category}</div>
    <h3 class="project-title">{project.title}</h3>
    <p>{project.description}</p>
  </div>
</a>