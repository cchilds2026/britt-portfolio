---
import BaseLayout from "../layouts/BaseLayout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import RevealScript from "../components/RevealScript.astro";
---

<BaseLayout
  title="Brittany Childs — Graphic Designer"
  description="Graphic designer specializing in branding, editorial publications, and athletics and signage for educational environments."
>
  <Nav />

  <main>
    <section class="section home-page-intro hero-grid">
      <div class="reveal">
        <div class="eyebrow">Selected Work</div>
        <h1 class="display">Brittany Childs</h1>
        <p class="lead">
          Graphic Designer with 5 years of experience creating branding,
          editorial publications, and environmental graphics for multiple school
          districts through CABOCES. Her work brings together clarity,
          consistency, and thoughtful design for educational audiences.
        </p>

        <div class="button-row">
          <a class="button" href="/work">View Selected Work</a>
          <a class="button" href="/resume">Resume</a>
        </div>
      </div>

      <div class="frame reveal">
        <img
          src="/images/Intro.JPG"
          alt="Brittany practicing photography on a boat."
        />
      </div>
    </section>

    <section class="section home-feature-section feature-grid">
      <div class="frame reveal">
        <img
          src="/images/branding-environments/school-environment/school-environment-06.jpg"
          alt="Workers installing vinyl design on window featuring  Cattaraugus Little Valley High School Timberwolves logo and colors."
          data-label="Large format installation CLV"
        />
      </div>

      <div class="reveal home-feature-copy">
        <div class="eyebrow">Featured Category</div>
        <h2 class="project-title home-feature-title">
          Branding & Environments
        </h2>
        <p>
          Branding work spanning standards development, branded school spaces,
          and sensory-environment design. This category combines process-driven
          systems work with completed real-world environmental application.
        </p>
        <a class="button" href="/work/branding-environments">View Branding Work</a>
      </div>
    </section>

    <section class="section home-projects-section">
      <div class="eyebrow">Selected Projects</div>
      <div class="grid-3">
        <a class="card reveal" href="/work/branding-environments">
          <div class="card-body home-project-card-body">
            <div class="meta">Branding</div>
            <h3 class="project-title">Branding & Environments</h3>
            <p>
              Brand standards, branded school spaces, and sensory-environment
              work presented as one cohesive institutional branding category.
            </p>
          </div>
        </a>

        <a class="card reveal" href="/work/editorial-publications">
          <div class="card-body home-project-card-body">
            <div class="meta">Publications</div>
            <h3 class="project-title">Editorial & Publications</h3>
            <p>
              Newsletters, handbooks, planners, print communication materials,
              and special print pieces designed for clarity and structure.
            </p>
          </div>
        </a>

        <a class="card reveal" href="/work/athletics-signage">
          <div class="card-body home-project-card-body">
            <div class="meta">Environmental Graphics</div>
            <h3 class="project-title">Athletics & Signage</h3>
            <p>
              Athletics graphics, building signage, acrylic nameplates, and
              accessibility-minded communication signage for school spaces.
            </p>
          </div>
        </a>
      </div>
    </section>

    <section class="section home-process-section">
      <div class="process-strip reveal">
        <div>
          <strong>Branding & Identity</strong>
          <p>
            Systems and environments designed to reinforce school identity over time.
          </p>
        </div>
        <div>
          <strong>Institutional Communication</strong>
          <p>
            Editorial materials built for readability, usability, and recurring use.
          </p>
        </div>
        <div>
          <strong>Environmental Application</strong>
          <p>
            Signage and large-scale graphics designed for visibility, function, and place.
          </p>
        </div>
      </div>
    </section>
  </main>

  <Footer />
  <RevealScript />
</BaseLayout>