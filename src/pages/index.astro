---
import BaseLayout from "../layouts/BaseLayout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import RevealScript from "../components/RevealScript.astro";
import ImageCarousel from "../components/ImageCarousel.astro";

const brandingPreviewImages = [
  {
    src: "https://placehold.co/1200x1500/e9e1d7/1f1b18?text=Branding+Guide",
    alt: "Brand guide preview placeholder",
    caption: "Brand standards development, branded school spaces, and sensory-environment work presented as one branding category."
  },
  {
    src: "https://placehold.co/1200x1500/e9e1d7/1f1b18?text=School+Environment",
    alt: "Branded environment preview placeholder",
    caption: "Completed school environment graphics showing branding applied across real spaces."
  },
  {
    src: "https://placehold.co/1200x1500/e9e1d7/1f1b18?text=Sensory+Hallway",
    alt: "Sensory hallway preview placeholder",
    caption: "Environmental work shaped by branding, user experience, and accessibility-minded design."
  }
];

const editorialPreviewImages = [
  {
    src: "https://placehold.co/1200x1500/e9e1d7/1f1b18?text=Newsletters",
    alt: "Newsletter preview placeholder",
    caption: "Editorial and publication materials designed for clarity, structure, and recurring use."
  },
  {
    src: "https://placehold.co/1200x1500/e9e1d7/1f1b18?text=Handbooks+and+Planners",
    alt: "Handbook and planner preview placeholder",
    caption: "Organizational documents, calendars, planners, and handbooks built for readability and practical use."
  },
  {
    src: "https://placehold.co/1200x1500/e9e1d7/1f1b18?text=Greeting+Cards",
    alt: "Greeting card preview placeholder",
    caption: "Special print pieces and communication materials presented with an editorial mindset."
  }
];

const athleticsPreviewImages = [
  {
    src: "https://placehold.co/1200x1500/e9e1d7/1f1b18?text=Athletics+Graphics",
    alt: "Athletics graphics preview placeholder",
    caption: "Athletics-focused graphics including decals, score tables, and branded school-spirit applications."
  },
  {
    src: "https://placehold.co/1200x1500/e9e1d7/1f1b18?text=Signage",
    alt: "Signage preview placeholder",
    caption: "Building signage systems designed for communication, branding, and environmental clarity."
  },
  {
    src: "https://placehold.co/1200x1500/e9e1d7/1f1b18?text=Accessible+Signs",
    alt: "Accessible signage preview placeholder",
    caption: "Wayfinding and informational signs incorporating accessibility and institutional identity."
  }
];
---

<BaseLayout
  title="Brittany Childs — Graphic Designer"
  description="Graphic designer specializing in branding, editorial publications, and athletics and signage for educational environments."
>
  <Nav />

  <main>
    <section class="section home-page-intro hero-grid">
      <div class="reveal">
        <div class="eyebrow">Selected Work</div>
        <h1 class="display">Brittany Childs</h1>
        <p class="lead">
          Graphic Designer with 5 years of experience creating branding,
          editorial publications, and environmental graphics for multiple school
          districts through CABOCES. Her work brings together clarity,
          consistency, and thoughtful design for educational audiences.
        </p>

        <div class="button-row">
          <a class="button" href="/work">View Selected Work</a>
          <a class="button" href="/resume">Resume</a>
        </div>
      </div>

      <div class="frame reveal">
        <img
          src="https://placehold.co/1600x1000/e9e1d7/1f1b18?text=Featured+Visual"
          alt="Featured portfolio visual"
        />
      </div>
    </section>

    <section class="section home-feature-section feature-grid">
      <div class="frame reveal">
        <img
          src="https://placehold.co/1600x1000/e9e1d7/1f1b18?text=Branding+and+Environments"
          alt="Branding and environments preview"
        />
      </div>

      <div class="reveal home-feature-copy">
        <div class="eyebrow">Featured Category</div>
        <h2 class="project-title" style="font-size: 2rem;">
          Branding & Environments
        </h2>
        <p>
          Branding work spanning standards development, branded school spaces,
          and sensory-environment design. This category combines process-driven
          systems work with completed real-world environmental application.
        </p>
        <a class="button" href="/work/branding-environments">View Branding Work</a>
      </div>
    </section>

    <section class="section home-projects-section">
      <div class="eyebrow">Selected Projects</div>
      <div class="grid-3">
        <article class="card reveal">
          <ImageCarousel images={brandingPreviewImages} id="home-branding-preview" mode="lightboxOnly" />
          <div class="card-body">
            <div class="meta">Branding</div>
            <h3 class="project-title">Branding & Environments</h3>
            <p>
              Brand standards, branded school spaces, and sensory-environment
              work presented as one cohesive institutional branding category.
            </p>
          </div>
        </article>

        <article class="card reveal">
          <ImageCarousel images={editorialPreviewImages} id="home-editorial-preview" mode="lightboxOnly" />
          <div class="card-body">
            <div class="meta">Publications</div>
            <h3 class="project-title">Editorial & Publications</h3>
            <p>
              Newsletters, handbooks, planners, print communication materials,
              and special print pieces designed for clarity and structure.
            </p>
          </div>
        </article>

        <article class="card reveal">
          <ImageCarousel images={athleticsPreviewImages} id="home-athletics-preview" mode="lightboxOnly" />
          <div class="card-body">
            <div class="meta">Environmental Graphics</div>
            <h3 class="project-title">Athletics & Signage</h3>
            <p>
              Athletics graphics, building signage, acrylic nameplates, and
              accessibility-minded communication signage for school spaces.
            </p>
          </div>
        </article>
      </div>
    </section>

    <section class="section home-process-section">
      <div class="process-strip reveal">
        <div>
          <strong>Branding & Identity</strong>
          <p>
            Systems and environments designed to reinforce school identity over time.
          </p>
        </div>
        <div>
          <strong>Institutional Communication</strong>
          <p>
            Editorial materials built for readability, usability, and recurring use.
          </p>
        </div>
        <div>
          <strong>Environmental Application</strong>
          <p>
            Signage and large-scale graphics designed for visibility, function, and place.
          </p>
        </div>
      </div>
    </section>
  </main>

  <Footer />
  <RevealScript />
</BaseLayout>