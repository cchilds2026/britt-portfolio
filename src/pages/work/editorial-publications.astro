---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
import RevealScript from "../../components/RevealScript.astro";
import ImageCarousel from "../../components/ImageCarousel.astro";

const publicationImages = [
  {
    src: "https://placehold.co/1200x1500/e9e1d7/1f1b18?text=Newsletters+1",
    alt: "Newsletter placeholder",
    caption: "Recurring publication materials designed for clarity, structure, and institutional communication."
  },
  {
    src: "https://placehold.co/1200x1500/e9e1d7/1f1b18?text=Newsletters+2",
    alt: "Publication spread placeholder",
    caption: "Editorial layouts built for readability, pacing, and organized communication."
  },
  {
    src: "https://placehold.co/1200x1500/e9e1d7/1f1b18?text=Print+Documents",
    alt: "Print document placeholder",
    caption: "Communication pieces designed to feel readable, polished, and practical for school audiences."
  }
];

const planningImages = [
  {
    src: "https://placehold.co/1200x1500/e9e1d7/1f1b18?text=Handbooks",
    alt: "Handbook placeholder",
    caption: "Organizational materials designed for navigation, consistency, and repeated use."
  },
  {
    src: "https://placehold.co/1200x1500/e9e1d7/1f1b18?text=Planners+and+Calendars",
    alt: "Planner and calendar placeholder",
    caption: "Planners and calendars built around function, readability, and durable structure."
  },
  {
    src: "https://placehold.co/1200x1500/e9e1d7/1f1b18?text=Organizational+Docs",
    alt: "Organizational document placeholder",
    caption: "Documents shaped by hierarchy and system thinking rather than decorative layout alone."
  }
];

const specialPrintImages = [
  {
    src: "https://placehold.co/1200x1500/e9e1d7/1f1b18?text=Greeting+Cards",
    alt: "Greeting card placeholder",
    caption: "Special print pieces designed with the same attention to tone, craft, and communication."
  },
  {
    src: "https://placehold.co/1200x1500/e9e1d7/1f1b18?text=Cards+and+Print+1",
    alt: "Special print placeholder",
    caption: "Smaller-format pieces that still require clarity, polish, and visual cohesion."
  },
  {
    src: "https://placehold.co/1200x1500/e9e1d7/1f1b18?text=Cards+and+Print+2",
    alt: "Special print detail placeholder",
    caption: "Editorial and print sensibility applied across a range of communication formats."
  }
];
---

<BaseLayout
  title="Editorial & Publications — Brittany Childs"
  description="Editorial and publication design including newsletters, handbooks, planners, calendars, and print communication materials."
>
  <Nav />

  <main>
    <section class="section editorial-page-intro">
      <div class="eyebrow">Publications</div>
      <h1 class="display" style="font-size: clamp(2.5rem, 6vw, 4.5rem);">
        Editorial & Publications
      </h1>
      <p class="lead">
        Editorial and print communication work designed for educational
        institutions, including recurring publications, organizational
        materials, and special print pieces.
      </p>
    </section>

    <section class="section editorial-hero-grid">
      <div class="frame reveal">
        <img
          src="https://placehold.co/1600x1000/e9e1d7/1f1b18?text=Editorial+and+Publications"
          alt="Editorial and publications overview"
        />
      </div>

      <div class="editorial-hero-copy reveal">
        <div class="editorial-hero-main">
          <h2 class="project-title" style="font-size: 2rem; margin-top: 0;">
            Printed communication shaped by structure, clarity, and continuity.
          </h2>

          <p>
            This category brings together the types of editorial and publication
            work that educational institutions rely on every day: newsletters,
            handbooks, calendars, planners, organizational documents, and
            special print pieces designed to communicate clearly and function well.
          </p>
        </div>

        <div class="editorial-hero-meta">
          <div class="meta">Client: Multiple school districts through CABOCES</div>
          <div class="meta">Role: Design, layout, production preparation</div>
          <div class="meta">Scope: Newsletters, handbooks, planners, calendars, print pieces</div>
        </div>
      </div>
    </section>

    <section class="section branding-split-section">
      <div class="branding-case-grid">
        <div class="branding-case-copy reveal">
          <div class="eyebrow">Section One</div>
          <h2 class="project-title" style="font-size: 2rem;">
            Publications & Newsletters
          </h2>
          <p>
            Recurring publications and print communication materials designed to
            support clarity, hierarchy, and institutional tone. This work
            focuses on editorial rhythm, typographic structure, and the ability
            to communicate information in a format that feels organized and
            useful to school audiences.
          </p>
        </div>

        <div class="branding-case-preview reveal">
          <ImageCarousel
            images={publicationImages}
            id="editorial-publications-preview"
            mode="lightboxOnly"
          />
        </div>
      </div>
    </section>

    <section class="section branding-split-section branding-split-section--second">
      <div class="branding-case-grid branding-case-grid--reverse">
        <div class="branding-case-preview reveal">
          <ImageCarousel
            images={planningImages}
            id="editorial-planning-preview"
            mode="lightboxOnly"
          />
        </div>

        <div class="branding-case-copy reveal">
          <div class="eyebrow">Section Two</div>
          <h2 class="project-title" style="font-size: 2rem;">
            Handbooks, Planners & Organizational Materials
          </h2>
          <p>
            Handbooks, planners, calendars, and other organizational documents
            require a more functional kind of editorial design. These projects
            emphasize navigation, consistency, usability, and the construction
            of durable page systems that can support repeated use.
          </p>
        </div>
      </div>
    </section>

    <section class="section branding-split-section branding-split-section--second">
      <div class="branding-case-grid">
        <div class="branding-case-copy reveal">
          <div class="eyebrow">Section Three</div>
          <h2 class="project-title" style="font-size: 2rem;">
            Greeting Cards & Special Print Pieces
          </h2>
          <p>
            Smaller print pieces such as greeting cards and special-format
            communications still rely on careful hierarchy, tone, and visual
            polish. This work shows how the same editorial discipline can scale
            down into more compact and expressive formats.
          </p>
        </div>

        <div class="branding-case-preview reveal">
          <ImageCarousel
            images={specialPrintImages}
            id="editorial-special-print-preview"
            mode="lightboxOnly"
          />
        </div>
      </div>
    </section>

    <section class="section editorial-summary-section">
      <div class="editorial-summary reveal">
        <div>
          <div class="eyebrow">Approach</div>
          <h2 class="project-title" style="font-size: 1.9rem;">
            Designed to be readable, usable, and institutionally coherent.
          </h2>
        </div>

        <div>
          <p>
            The work in this category is unified by an editorial approach:
            careful hierarchy, pacing, and layout systems that help information
            feel organized rather than overwhelming.
          </p>
        </div>

        <div>
          <p>
            Whether the format is recurring, organizational, or special-purpose,
            the goal is the same: materials that communicate clearly while still
            feeling polished and intentional.
          </p>
        </div>
      </div>
    </section>

    <section class="section" style="padding-top: 3rem;">
      <div class="eyebrow">Continue Exploring</div>
      <div class="case-nav-wrap reveal">
        <div class="case-nav">
          <a href="/work/branding-environments">
            <span class="label">Previous Project</span>
            <span class="title">Branding & Environments</span>
          </a>

          <a href="/work">
            <span class="label">All Work</span>
            <span class="title">Back to All Work</span>
          </a>

          <a href="/work/athletics-signage">
            <span class="label">Next Project</span>
            <span class="title">Athletics & Signage</span>
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
  <RevealScript />
</BaseLayout>