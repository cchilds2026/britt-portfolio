---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
import RevealScript from "../../components/RevealScript.astro";
import PdfPreview from "../../components/PdfPreview.astro";
import PdfPreviewThumbs from "../../components/PdfPreviewThumbs.astro";
import PdfDocumentList from "../../components/PdfDocumentList.astro";

const publicationDocs = [
  {
    src: "/pdf/Newsletter-01.pdf",
    label: "CLV Newsletter",
    caption: "September/October 2025 issue of Cattaraugus-Little Valley's district newsletter."
  },
  {
    src: "/pdf/Newsletter-02.pdf",
    label: "BRCS Newsletter",
    caption: "March 2026 issue of Bolivar-Richburg's district newsletter."
  },
  {
    src: "/pdf/Newsletter-03.pdf",
    label: "PVCS Newsletter",
    caption: "October 2025 issue of Pine Valley Central School's district newsletter."
  },
  {
    src: "/pdf/Newsletter-04.pdf",
    label: "WCSD Newsletter",
    caption: "October 2025 issue of Wellsville Central School's newsletter, The Overview."
  }
];

const planningDocs = [
  {
    src: "/pdf/Admin-01.pdf",
    label: "BOCES Ben Book",
    caption: "Cover design for CABOCES Salary & Benefit Data Book designed for employee reference. Published by Human Resources."
  },
  {
    src: "/pdf/Admin-02.pdf",
    label: "FCSD COC",
    caption: "Franklinville Central School Code of Conduct. Redesigned from inaccessible text to new production copy. Nominated for the 2025 NSPRA Award for Special Purpose Communication in Education. Award winners pending announcement."
  },
  {
    src: "/pdf/Admin-03.pdf",
    label: "CABOCES COC",
    caption: "Student Code of Conduct for CABOCES CTE Program. Cover designed by Brittany Childs, contents contributed by other designers."
  },
  {
    src: "/pdf/Calendar-01.pdf",
    label: "WCSD Calendar",
    caption: "Wellsville School Calendar for 2023-2024. Serves as the calendar mailed to the district as well as a resource for families with students in the district."
  },
  {
    src: "/pdf/Calendar-04.pdf",
    label: "CLV Calendar",
    caption: "Cattaraugus-Little Valley School Calendar for 2023-2024. Serves as the calendar mailed to the district as well as a resource for families with students in the district."
  },
  {
    src: "/pdf/Calendar-05.pdf",
    label: "PVCS Calendar",
    caption: "Pine Valley School Calendar for 2024-2025. Serves as the calendar mailed to the district as well as a resource for families with students in the district."
  },
  {
    src: "/pdf/Planner-01.pdf",
    label: "BRCS Employee Planner",
    caption: "Monthly planner designed for BRCS faculty and staff."
  },
  {
    src: "/pdf/Planner-02.pdf",
    label: "CABOCES Planner",
    caption: "Monthly planner designed for CABOCES. Distributed to students and faculty/staff in the CTE programs. Cover designed by Brittany Childs, contents contributed by other designers."
  }
];

const specialPrintDocs = [
  {
    src: "/pdf/Brochure-01.pdf",
    label: "Brochure",
    caption: "Brochure work showing editorial structure applied to smaller-format print communication."
  },
  {
    src: "/pdf/Cards-01.pdf",
    label: "CABOCES Cards",
    caption: "Various greeting cards designed for CABOCES. Intended to be sent to employees for special occasions."
  },
  {
    src: "/pdf/Flyer-02.pdf",
    label: "CABOCES Flyer",
    caption: "Summer recruitment flyer for the CABOCES Workforce Development Program."
  },
  {
    src: "/pdf/Flyer-03.pdf",
    label: "CABOCES Flyer",
    caption: "Summer recruitment flyer for the CABOCES Workforce Development Program."
  },
  {
    src: "/pdf/Flyer-04.pdf",
    label: "Rise",
    caption: "Employee wellness program flyer for RISE Academy."
  },
  {
    src: "/pdf/Stickers-01.pdf",
    label: "CABOCES Stickers",
    caption: "Thank-you stickers designed for the BOCES Admin team. Printed at 1.5-inch diameter and used on envelopes and gifts for employee recognition."
  }
];
---

<BaseLayout
  title="Editorial & Publications — Brittany Childs"
  description="Editorial and publication design including newsletters, handbooks, planners, calendars, and print communication materials."
>
  <Nav />

  <main>
    <section class="editorial-top-wrap editorial-top-wrap--title-inline">
      <div class="editorial-top-grid">
        <div class="editorial-top-media reveal">
          <div class="frame editorial-top-frame">
            <img
              src="/images/editorial-publications/COC-01.webp"
              alt="Cover photo of Franklinville Central School District Code of Conduct. Features school logo and colors, as well as photos taken of students during the school year."
              data-label="Code of Conduct Cover FVL"
              loading="eager"
              decoding="async"
            />
          </div>
        </div>

        <div class="editorial-top-copy reveal">
          <div class="eyebrow">Publications</div>
          <h1 class="display branding-page-title">
            Editorial & Publications
          </h1>
          <p class="lead">
            Editorial and print communication work designed for educational
            institutions, including recurring publications, organizational
            materials, and special print pieces.
          </p>

          <h2 class="project-title branding-hero-subtitle">
            Printed communication shaped by structure, clarity, and continuity.
          </h2>

          <p>
            This category brings together the types of editorial and publication
            work that educational institutions rely on every day: newsletters,
            handbooks, calendars, planners, organizational documents, and
            special print pieces designed to communicate clearly and function well.
          </p>

          <div class="editorial-hero-meta editorial-top-meta">
            <div class="meta">Client: Multiple school districts through CABOCES</div>
            <div class="meta">Role: Design, layout, production preparation</div>
            <div class="meta">Scope: Newsletters, handbooks, planners, calendars, print pieces</div>
          </div>
        </div>
      </div>
    </section>

    <section class="section branding-split-section">
      <div class="branding-case-grid editorial-case-grid">
        <div class="branding-case-copy editorial-case-copy reveal">
          <div class="eyebrow">Section One</div>
          <h2 class="project-title section-title">
            Publications & Newsletters
          </h2>
          <p>
            Recurring publications and print communication materials designed to
            support clarity, hierarchy, and institutional tone. This work
            focuses on editorial rhythm, typographic structure, and the ability
            to communicate information in a format that feels organized and
            useful to school audiences.
          </p>
          <p>
            These examples are presented as interactive document previews so the
            pacing, page systems, and reading experience can be seen more like a
            printed portfolio than a set of isolated images.
          </p>

          <div class="editorial-doc-nav editorial-doc-nav--desktop">
            <PdfPreviewThumbs
              targetId="editorial-publications-preview"
              documents={publicationDocs}
            />
          </div>

          <div class="editorial-doc-list editorial-doc-list--mobile">
            <PdfDocumentList documents={publicationDocs} />
          </div>
        </div>

        <div class="branding-case-preview reveal editorial-preview--desktop">
          <div class="editorial-pdf-preview">
            <PdfPreview
              id="editorial-publications-preview"
              documents={publicationDocs}
              showThumbs={false}
            />
          </div>
        </div>
      </div>
    </section>

    <section class="section branding-split-section branding-split-section--second">
      <div class="branding-case-grid branding-case-grid--reverse editorial-case-grid">
        <div class="branding-case-preview reveal editorial-preview--desktop">
          <div class="editorial-pdf-preview">
            <PdfPreview
              id="editorial-planning-preview"
              documents={planningDocs}
              showThumbs={false}
            />
          </div>
        </div>

        <div class="branding-case-copy editorial-case-copy reveal">
          <div class="eyebrow">Section Two</div>
          <h2 class="project-title section-title">
            Handbooks, Planners & Organizational Materials
          </h2>
          <p>
            Handbooks, planners, calendars, and other organizational documents
            require a more functional kind of editorial design. These projects
            emphasize navigation, consistency, usability, and the construction
            of durable page systems that can support repeated use.
          </p>
          <p>
            In these materials, hierarchy and pacing are as important as the
            visual system itself because the documents are meant to be used,
            revisited, and understood over time.
          </p>

          <div class="editorial-doc-nav editorial-doc-nav--desktop">
            <PdfPreviewThumbs
              targetId="editorial-planning-preview"
              documents={planningDocs}
            />
          </div>

          <div class="editorial-doc-list editorial-doc-list--mobile">
            <PdfDocumentList documents={planningDocs} />
          </div>
        </div>
      </div>
    </section>

    <section class="section branding-split-section branding-split-section--second">
      <div class="branding-case-grid editorial-case-grid">
        <div class="branding-case-copy editorial-case-copy reveal">
          <div class="eyebrow">Section Three</div>
          <h2 class="project-title section-title">
            Greeting Cards & Special Print Pieces
          </h2>
          <p>
            Smaller print pieces such as greeting cards and special-format
            communications still rely on careful hierarchy, tone, and visual
            polish. This work shows how the same editorial discipline can scale
            down into more compact and expressive formats.
          </p>
          <p>
            These examples broaden the category beyond recurring publications and
            show how print design can remain clear and intentional across a
            range of formats.
          </p>

          <div class="editorial-doc-nav editorial-doc-nav--desktop">
            <PdfPreviewThumbs
              targetId="editorial-special-print-preview"
              documents={specialPrintDocs}
            />
          </div>

          <div class="editorial-doc-list editorial-doc-list--mobile">
            <PdfDocumentList documents={specialPrintDocs} />
          </div>
        </div>

        <div class="branding-case-preview reveal editorial-preview--desktop">
          <div class="editorial-pdf-preview">
            <PdfPreview
              id="editorial-special-print-preview"
              documents={specialPrintDocs}
              showThumbs={false}
            />
          </div>
        </div>
      </div>
    </section>

    <section class="section editorial-summary-section">
      <div class="editorial-summary reveal">
        <div>
          <div class="eyebrow">Approach</div>
          <h2 class="project-title summary-title">
            Designed to be readable, usable, and institutionally coherent.
          </h2>
        </div>

        <div>
          <p>
            The work in this category is unified by an editorial approach:
            careful hierarchy, pacing, and layout systems that help information
            feel organized rather than overwhelming.
          </p>
        </div>

        <div>
          <p>
            Whether the format is recurring, organizational, or special-purpose,
            the goal is the same: materials that communicate clearly while still
            feeling polished and intentional.
          </p>
        </div>
      </div>
    </section>

    <section class="section continue-exploring-section">
      <div class="eyebrow">Continue Exploring</div>
      <div class="case-nav-wrap reveal">
        <div class="case-nav">
          <a href="/work/branding-environments">
            <span class="label">Previous Project</span>
            <span class="title">Branding & Environments</span>
          </a>

          <a href="/work">
            <span class="label">All Work</span>
            <span class="title">Back to All Work</span>
          </a>

          <a href="/work/athletics-signage">
            <span class="label">Next Project</span>
            <span class="title">Athletics & Signage</span>
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
  <RevealScript />
</BaseLayout>