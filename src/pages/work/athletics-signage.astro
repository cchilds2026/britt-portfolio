---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
import RevealScript from "../../components/RevealScript.astro";
import ImageCarousel from "../../components/ImageCarousel.astro";

const athleticsImages = [
  {
    src: "/images/athletics-signage/athletics-graphics/athletics-graphics-01.jpg",
    alt: "Athletics graphics 1",
    caption:
      "Athletics-focused graphics including decals, score tables, and school-spirit applications."
  },
  {
    src: "/images/athletics-signage/athletics-graphics/athletics-graphics-02.JPG",
    alt: "Athletics graphics 2",
    caption:
      "Large-scale athletics graphics designed to reinforce school identity and visibility."
  },
  {
    src: "/images/athletics-signage/athletics-graphics/athletics-graphics-03.JPG",
    alt: "Athletics graphics 3",
    caption:
      "Athletics graphics built for school spirit, function, and environmental presence."
  },
  {
    src: "/images/athletics-signage/athletics-graphics/athletics-graphics-04.png",
    alt: "Athletics graphics 4",
    caption:
      "Environmental graphics designed to strengthen school identity within athletic spaces."
  },
  {
    src: "/images/athletics-signage/athletics-graphics/athletics-graphics-05.jpg",
    alt: "Athletics graphics 5",
    caption:
      "Athletics branding applied across school environments through bold, visible graphic systems."
  }
];

const signageImages = [
  {
    src: "/images/athletics-signage/school-signage/school-signage-09.jpeg",
    alt: "School signage overview",
    caption:
      "School signage and environmental branding designed to create a clearer and more cohesive building experience."
  },
  {
    src: "/images/athletics-signage/school-signage/school-signage-01.jpg",
    alt: "School signage 1",
    caption:
      "Building signage designed to communicate clearly while staying aligned with school branding."
  },
  {
    src: "/images/athletics-signage/school-signage/school-signage-02.jpg",
    alt: "School signage 2",
    caption:
      "Acrylic nameplates and environmental signs designed for consistency and visual clarity."
  },
  {
    src: "/images/athletics-signage/school-signage/school-signage-03.jpg",
    alt: "School signage 3",
    caption:
      "Signage systems supporting wayfinding, visibility, and institutional presence."
  },
  {
    src: "/images/athletics-signage/school-signage/school-signage-04.jpg",
    alt: "School signage 4",
    caption:
      "Environmental signage supporting wayfinding and institutional identity."
  },
  {
    src: "/images/athletics-signage/school-signage/school-signage-05.jpg",
    alt: "School signage 5",
    caption:
      "School communication signage designed for clarity and consistency."
  },
  {
    src: "/images/athletics-signage/school-signage/school-signage-06.JPG",
    alt: "School signage 6",
    caption:
      "Large-format school signage integrated into the built environment."
  },
  {
    src: "/images/athletics-signage/school-signage/school-signage-07.JPG",
    alt: "School signage 7",
    caption:
      "Wayfinding and building graphics designed to reinforce school identity."
  },
  {
    src: "/images/athletics-signage/school-signage/school-signage-08.JPG",
    alt: "School signage 8",
    caption:
      "School signage applications built for visibility, function, and cohesion."
  }
];

const accessibilityImages = [
  {
    src: "/images/athletics-signage/accessibility-signage/accessibility-signage-01.png",
    alt: "Accessibility signage 1",
    caption:
      "Informational signs designed with readability and accessibility in mind."
  },
  {
    src: "/images/athletics-signage/accessibility-signage/accessibility-signage-02.png",
    alt: "Accessibility signage 2",
    caption:
      "Environmental communication pieces built to support broad use within the school building."
  }
];
---

<BaseLayout
  title="Athletics & Signage — Brittany Childs"
  description="Athletics graphics, school signage systems, and accessibility-minded environmental design work by Brittany Childs."
>
  <Nav />

  <main>

    <section class="section editorial-page-intro">
      <div class="eyebrow">Environmental Graphics</div>
      <h1 class="display branding-page-title">
        Athletics & Signage
      </h1>
      <p class="lead">
        Environmental graphics and signage created for school spaces, combining
        athletics identity, building communication, and accessibility-minded use.
      </p>
    </section>

    <section class="section branding-top-grid">
      <div class="branding-top-images reveal">
        <div class="branding-top-image">
          <img
            src="/images/athletics-signage/school-signage/school-signage-04.jpg"
            alt="Athletics and signage overview"
          />
        </div>
      </div>

      <div class="branding-top-copy reveal">
        <h2 class="project-title branding-hero-subtitle">
          Environmental graphics built for spirit, clarity, and everyday use.
        </h2>

        <p>
          This category includes athletics-focused graphics, school signage,
          acrylic nameplates, and communication signs designed to work within
          active educational environments. The work balances visibility,
          branding, function, and accessibility across a range of scales.
        </p>

        <div class="editorial-hero-meta branding-top-meta">
          <div class="meta">Client: Multiple school districts through CABOCES</div>
          <div class="meta">Role: Graphic design, signage design, environmental graphics</div>
          <div class="meta">Scope: Athletics graphics, signage systems, nameplates, accessible communication signs</div>
        </div>
      </div>
    </section>
    <section class="section branding-split-section">
      <div class="branding-case-grid">
        <div class="branding-case-copy reveal">
          <div class="eyebrow">Section One</div>
          <h2 class="project-title" style="font-size: 2rem;">
            Athletics Graphics
          </h2>
          <p>
            Athletics work includes wall decals, score tables, concession stand
            graphics, and other visual applications designed to reinforce school
            spirit, presence, and branded identity within athletic spaces.
          </p>
          <p>
            These projects emphasize visibility, energy, and the use of
            large-format design to build a stronger sense of place and school
            culture.
          </p>
        </div>

        <div class="branding-case-preview reveal">
          <ImageCarousel
            images={athleticsImages}
            id="athletics-graphics-preview"
            mode="splitPreview"
          />
        </div>
      </div>
    </section>

    <section class="section branding-split-section branding-split-section--second">
      <div class="branding-case-grid branding-case-grid--reverse">
        <div class="branding-case-preview reveal">
          <ImageCarousel
            images={signageImages}
            id="school-signage-preview"
            mode="splitPreview"
          />
        </div>

        <div class="branding-case-copy reveal">
          <div class="eyebrow">Section Two</div>
          <h2 class="project-title" style="font-size: 2rem;">
            School Signage Systems
          </h2>
          <p>
            Building signage and acrylic nameplates support communication across
            school environments while staying visually aligned with branding.
            These pieces are designed to feel clear, consistent, and durable in
            use.
          </p>
          <p>
            This section focuses on signage as both a practical system and a
            visible part of the school environment.
          </p>
        </div>
      </div>
    </section>

    <section class="section branding-split-section branding-split-section--second">
      <div class="branding-case-grid">
        <div class="branding-case-copy reveal">
          <div class="eyebrow">Section Three</div>
          <h2 class="project-title" style="font-size: 2rem;">
            Accessibility & Communication
          </h2>
          <p>
            Some signage projects focus specifically on communication needs within
            the building, including signs shaped by accessibility, readability,
            and the practical realities of moving through school spaces.
          </p>
          <p>
            These pieces show how environmental graphics can support broader use,
            clearer communication, and a more inclusive experience of the school.
          </p>
        </div>

        <div class="branding-case-preview reveal">
          <ImageCarousel
            images={accessibilityImages}
            id="accessibility-signage-preview"
            mode="splitPreview"
          />
        </div>
      </div>
    </section>

    <section class="section editorial-summary-section">
      <div class="editorial-summary reveal">
        <div>
          <div class="eyebrow">Approach</div>
          <h2 class="project-title" style="font-size: 1.9rem;">
            Designed for visibility, function, and institutional presence.
          </h2>
        </div>

        <div>
          <p>
            The work in this category balances school identity with practical
            use, bringing together spirit-driven graphics, signage systems, and
            communication needs across active educational spaces.
          </p>
        </div>

        <div>
          <p>
            Together, these projects show how environmental graphics can support
            both school culture and day-to-day clarity throughout a building.
          </p>
        </div>
      </div>
    </section>

    <section class="section" style="padding-top: 3rem;">
      <div class="eyebrow">Continue Exploring</div>
      <div class="case-nav-wrap reveal">
        <div class="case-nav">
          <a href="/work/editorial-publications">
            <span class="label">Previous Project</span>
            <span class="title">Editorial & Publications</span>
          </a>

          <a href="/work">
            <span class="label">All Work</span>
            <span class="title">Back to All Work</span>
          </a>

          <a href="/work/branding-environments">
            <span class="label">Next Project</span>
            <span class="title">Branding & Environments</span>
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
  <RevealScript />
</BaseLayout>