---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
import RevealScript from "../../components/RevealScript.astro";
import ImageCarousel from "../../components/ImageCarousel.astro";

const heroImages = [
  {
    src: "/images/branding-environments/school-environment/school-environment-07.jpg",
    label: "Large format installation CLV",
    alt: 'Installed graphic at Cattaraugus-Little Valley High School with school colors, a wolf face and text saying "Home of the Timberwolves" for the parent pickup area.'
  },
  {
    src: "/images/branding-environments/school-environment/school-environment-08.jpg",
    label: "Large format installation CLV",
    alt: 'Installed graphic at Cattaraugus-Little Valley High School with school colors, a wolf face and text saying "Home of the Timberwolves" for the parent pickup area.'
  }
];

const brandGuideProcessImages = [
  {
    src: "/images/branding-environments/brand-guide-process/brand-guide-process-01.png",
    label: "Brand Guide Cover",
    alt: "Cover photo of the Branding Guide in progress for Jamestown Public Schools.",
    caption: "Cover photo of the Branding Guide in progress for Jamestown Public Schools."
  },
  {
    src: "/images/branding-environments/brand-guide-process/brand-guide-process-02.png",
    label: "Brand Guide Pg 2",
    alt: "Page of the Branding Guide introducing the section dedicated to CV Bush Elementary School.",
    caption: "Page of the Branding Guide introducing the section dedicated to CV Bush Elementary School."
  },
  {
    src: "/images/branding-environments/brand-guide-process/brand-guide-process-03.png",
    label: "Brand Guide Pg 3",
    alt: "About us page describing the school's identity and publication style. Text in photo obscured as the guide is incomplete and unpublished at this time.",
    caption: "About us page describing the school's identity and publication style. Text in photo obscured as the guide is incomplete and unpublished at this time."
  },
  {
    src: "/images/branding-environments/brand-guide-process/brand-guide-process-04.png",
    label: "Brand Guide Pg 4",
    alt: "Typography guide to standardize print practices and unify presentation across school districts.",
    caption: "Typography guide to standardize print practices and unify presentation across school districts."
  }
];

const environmentImages = [
  {
    src: "/images/branding-environments/school-branding/school-branding-01.JPG",
    label: "HSD Entrance",
    alt: "Large format door wrap designed for the entrance of HSD. Features school branding and mascot with the text \"Home of the Bobcats\"",
    caption: "Large format vinyl door wrap designed for HSD. This design was selected for the 2023 Award for Excellence in Special Purpose Communications by both NSPRA and NYSPRA."
  },
  {
    src: "/images/branding-environments/school-branding/school-branding-02.PNG",
    label: "HSD Side Entrance",
    alt: "Large format door wrap designed for the side entrance of HSD. Features school mascot and colors.",
    caption: "Additional door wrap for the side entrance to the school Designed relative to the main entrance without replicating elements directly to provide additional visual interest while maintaining brand identity and cohesion."
  },
  {
    src: "/images/branding-environments/school-branding/school-branding-03.JPG",
    label: "HSD Wall Logos",
    alt: "Large wall vinyl graphics that reads Welcome Home Bobcats in Blue.",
    caption: "The design motifs were continued throughout the school. Special attention was paid to avoid repitition while still staying true to branding style and color palettes."
  },
  {
    src: "/images/branding-environments/school-branding/school-branding-04.JPG",
    label: "HSD Wall Graphic",
    alt: "Large wall vinyl graphic featuring a bobcat looking over trees",
    caption: "Additional graphics and illustrations utilized throughout the space to continue visual interest while avoiding text heavy design choices."
  },
  {
    src: "/images/branding-environments/school-environment/school-environment-01.png",
    label: "ALCS Windows",
    alt: "Large graphic featuring animals in a swamp environment.",
    caption: "Large format window installation across the entrance of Allegany Limestone Elementary School. This graphic was designed without specific branding rules in order to meet the district's request for creating a focus on the environment and a welcome space for a younger audience. Stylized 'gators' in their natural environment to help make the space feel welcoming to young students."
  },
  {
    src: "/images/branding-environments/school-environment/school-environment-02.jpeg",
    label: "BCS Stairs",
    alt: "Large graphic installed on stairs featuring Belfast Central School Branding with motivational text.",
    caption: "Vinyl graphics designed for the risers of the staircase to bring a visual interest to a high traffic area in a way that would be non-disruptive while reinforcing district messaging where it would be seen frequently by students."
  },
  {
    src: "/images/branding-environments/school-environment/school-environment-03.jpeg",
    label: "ALCS Bus Garage",
    alt: "Vinyl door wrap featuring ALCS Gator Logo with text saying Welcome to the Transportation Department",
    caption: "Vinyl door wrap for the ALCS Bus Garage. This design needed to feature the same branding and style as the rest of the school areas, but needed to feel distinctive rather than using mascot or athletic imagery."
  },
  {
    src: "/images/branding-environments/school-environment/school-environment-04.jpg",
    label: "Randolph Library",
    alt: "Window graphics depicting a cartoon cardinal reading books.",
    caption: "Window graphics designed for Randolph CSD to bring visual interest and make the space near the library more inviting for students. Each book cover spine was individually designed to avoid copywright infringement while maintaining the identify of the books chosen to feel most familiar to the students. The cardinal was also custom illustrated to depict their school mascot portrayed as more child friendly to fit the space and target audience."
  },
