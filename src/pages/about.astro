---
import BaseLayout from "../layouts/BaseLayout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import RevealScript from "../components/RevealScript.astro";
import ImageCarousel from "../components/ImageCarousel.astro";
import PdfPreview from "../components/PdfPreview.astro";

const awards = [
  {
    title: "2022 NSPRA Honorable Mention",
    year: "2022",
    agency: "NSPRA",
    logo: "/NSPRA-Logo.png",
    ribbon: "/nspra-ribbon.png",
    url: "https://www.nspra.org/Awards/Award-Winners/2022-Publications-and-Digital-Media-Excellence-Winners#special:~:text=Cattaraugus%2DAllegany%20BOCES%2C%20Olean%2C%20New%20York%C2%A0%C2%A0%C2%A0%C2%A0%20I%C2%A0%C2%A0%C2%A0%C2%A0%C2%A0CA%20BOCES%20CTE%20Onboarding%20Booklet%20%2D%20Designer%3A%20Brittany%20Campbell%C2%A0%C2%A0%C2%A0%C2%A0%C2%A0%20I%C2%A0%C2%A0%C2%A0%20Submitted%20by%3A%20Jessica%20Golley%2C%20Marketing%2C%20Brand%20%26%20Communication%20Coordinator",
    previewType: "pdf",
    previewDocs: [
      {
        src: "/pdf/Onboarding_Book.pdf",
        label: "Award Entry",
        caption:
          "This onboarding handbook was designed for new employees with BOCES CTE programs. Nominated for excellence in Special Purpose Education."
      }
    ],
    previewImages: []
  },
  {
    title: "2023 NSPRA Award for Excellence in Special Purpose Education",
    year: "2023",
    agency: "NSPRA",
    logo: "/NSPRA-Logo.png",
    ribbon: "/nspra-ribbon.png",
    url: "https://www.nspra.org/Awards/Award-Winners/2023-Publications-and-Digital-Media-Excellence-Winners#:~:text=Cattaraugus%2DAllegany%20BOCES%2C%20Olean%2C%20New%20York%0ASubmitted%20by%3A%20Jessica%20Golley%2C%20Marketing%2C%20Brand%20%26%20Communication%20Coordinator%0AAward%20Entry%3A%0AHinsdale%20Main%20Entrance%20Design%20%2D%20Brittany%20Childs",
    previewType: "image",
    previewDocs: [],
    previewImages: [
      {
        src: "/images/awards/award-02-3.JPG",
        alt: "Preview of awarded design piece 2",
        caption:
          "This graphic was designed for the entrance door to Hinsdale Central School. Nominated for excellence in Special Purpose Education."
      }
    ]
  },
  {
    title: "2023 NYSPRA Award for Excellence in Special Purpose Education",
    year: "2023",
    agency: "NYSPRA",
    logo: "/NYSPRA-Logo.png",
    ribbon: "/NYSPRA-ribbon.png",
    url: "/pdf/44th-nyspra-awards-contest-winners.pdf#page=2&search=Childs",
    previewType: "image",
    previewDocs: [],
    previewImages: [
      {
        src: "/images/awards/award-02-3.JPG",
        alt: "Preview of awarded design piece 3",
        caption:
          "This graphic was designed for the entrance door to Hinsdale Central School. Nominated for excellence in Special Purpose Education."
      }
    ]
  },
  {
    title: "2025 Nomination for NSPRA Award",
    year: "2025",
    agency: "NSPRA",
    logo: "/NSPRA-Logo.png",
    ribbon: "",
    url: "",
    label: "Pending announcement of winners",
    previewType: "pdf",
    previewDocs: [
      {
        src: "/pdf/Admin-02.pdf",
        label: "Nominated Entry",
        caption:
          "This Student Code of Conduct manual was designed for Franklinville Central School/Ten Broeck Academy. Nominated for excellence in Special Purpose Education, announcement of awards pending."
      }
    ],
    previewImages: []
  }
];
---

<BaseLayout
  title="About — Brittany Childs"
  description="About Brittany Childs."
>
  <Nav />

  <main>
    <section class="section about-page">
      <div class="about-intro reveal">
        <div class="about-portrait about-portrait--circle frame">
          <img
            src="/AboutProfile.jpeg"
            alt="Portrait of Brittany Childs"
          />
        </div>

        <div class="eyebrow">About</div>
        <h1 class="display" style="font-size: clamp(2.5rem, 6vw, 4.5rem);">
          About Me
        </h1>
      </div>

      <div class="about-body reveal">
        <p class="lead">
          I’m a graphic designer with 5 years of experience creating branded
          communications for multiple school districts through CABOCES. My work
          spans brand systems, publication design, large-format graphics, and
          institutional materials built for clarity, consistency, and effective
          communication across diverse audiences.
        </p>

        <p>
          I work across complex stakeholder environments, balancing strong visual
          design with production realities, approval workflows, and long-term
          usability. My experience includes recurring publications,
          environmental graphics, and large-scale standards work such as the
          Jamestown Area Schools brand book, where I am helping define both the
          visual system and the process for future brand-book development.
        </p>

        <p>
          I’m especially interested in design that supports clear communication
          and inclusive use. That includes thoughtful attention to hierarchy,
          readability, and accessibility-minded decisions that help materials
          work well for broad audiences in educational settings.
        </p>

        <p>
          My approach combines editorial discipline, systems thinking, and
          production-aware execution. I’ve also been recognized with multiple
          design awards, and I bring that same attention to craft and detail to
          every project, whether it is a brand standards system, a publication,
          or a large-format environmental piece.
        </p>

        <p>
          I’m always interested in opportunities involving educational
          communications, institutional branding, publication design, and
          large-format work. You can reach me at
          <a href="mailto:brittanyalexcampbell92@yahoo.com">
            brittanyalexcampbell92@yahoo.com
          </a>.
        </p>
      </div>
    </section>

    <section class="section awards-section">
      <div class="eyebrow">Recognition</div>
      <h2 class="project-title" style="font-size: 2rem; margin-bottom: 1.5rem;">
        Selected Awards
      </h2>

      <div class="awards-grid awards-grid--four">
        {awards.map((award, index) => (
          <article class="award-card reveal">
            <div class="award-header">
              <img
                class={`award-logo award-logo--${index + 1}`}
                src={award.logo}
                alt={`${award.agency} logo`}
              />
            </div>

            <div class="award-preview-wrap">
              <div class="award-preview">
                {award.previewType === "pdf" ? (
                  <PdfPreview
                    id={`award-preview-${index}`}
                    documents={award.previewDocs ?? []}
                  />
                ) : (
                  <ImageCarousel
                    images={award.previewImages ?? []}
                    id={`award-preview-${index}`}
                    mode="splitPreview"
                  />
                )}
              </div>

              {award.ribbon && (
                <div class="award-ribbon-badge">
                  <img
                    class="award-ribbon"
                    src={award.ribbon}
                    alt={`${award.year} ribbon`}
                  />
                </div>
              )}
            </div>

            <div class="award-copy">
              <h3 class="project-title">{award.title}</h3>

              {award.url ? (
                <a
                  class="award-link"
                  href={award.url}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  View Award Listing
                </a>
              ) : (
                <div class="award-status">
                  {award.label || "Pending announcement of winners"}
                </div>
              )}
            </div>
          </article>
        ))}
      </div>
    </section>
  </main>

  <Footer />
  <RevealScript />
</BaseLayout>